# --- App ---
APP_URL=http://localhost:8300          # public origin (Cloudflare Tunnel hostname in prod)
PORT=8300
ADMIN_JWT_SECRET=change-me-64-random-chars

# --- Database (docker-compose service `db`) ---
DATABASE_URL=postgres://reservasi:reservasi@localhost:5433/reservasi
POSTGRES_PASSWORD=reservasi

# --- Calq EMR ---
CALQ_ENV=sandbox                       # sandbox | production (overridable via app_settings.calq_env)
CALQ_BASE_URL_SANDBOX=https://simrs-adera-dev-local.techave.dev
CALQ_BASE_URL_PRODUCTION=https://api-calq.klinikadera.co.id
CALQ_API_KEY_SANDBOX=
CALQ_API_KEY_PRODUCTION=
CALQ_PAYMENT_METHOD_ID_SANDBOX=14      # Doku
CALQ_PAYMENT_METHOD_ID_PRODUCTION=3

# --- DOKU ---
DOKU_ENV=sandbox                       # sandbox | production (overridable via app_settings.doku_env)
DOKU_CLIENT_ID_SANDBOX=
DOKU_SECRET_KEY_SANDBOX=
DOKU_CLIENT_ID_PRODUCTION=
DOKU_SECRET_KEY_PRODUCTION=

# --- SMTP (invoice email; never store these in the database) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Klinik Adera
SMTP_DKIM_SELECTOR=app
SMTP_DKIM_KEY=                         # base64 -w0 < key.pem (PEM cannot span .env lines)
